@model LearnSphere.Models.Course

@{
    ViewData["Title"] = "Review Course";
    var lessons = Model.CurrentVersion?.Lessons.OrderBy(l => l.OrderIndex) ?? Enumerable.Empty<LearnSphere.Models.Lesson>();
}

<p class="text-muted mb-1"><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></p>
<span class="badge bg-secondary mb-2">@Model.Difficulty</span>
<h1 class="mb-1">@Model.Title</h1>
<p class="text-muted">
    By @Model.Instructor.FirstName @Model.Instructor.LastName &middot; @Model.Category.Name &middot; @Model.EstimatedDurationHours hrs
</p>
<p>@Model.Description</p>

<h2 class="h4 mt-4">Lessons</h2>
@if (!lessons.Any())
{
    <p class="text-muted">No lessons.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var lesson in lessons)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    @lesson.OrderIndex. @lesson.Title
                    <span class="badge bg-secondary ms-1">@lesson.ContentType</span>
                </span>
                <span class="text-muted small">@lesson.DurationMinutes min</span>
            </li>
        }
    </ul>
}

<div class="d-flex gap-2">
    <form asp-controller="Admin" asp-action="Approve" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-success">Approve & Publish</button>
    </form>
    <form asp-controller="Admin" asp-action="Reject" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-danger">Reject (send back to draft)</button>
    </form>
</div>
