@model LearnSphere.Models.ViewModels.CategoryFormViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<p class="text-muted mb-1"><a asp-controller="Admin" asp-action="Categories">Categories</a></p>
<h1 class="mb-4">Edit Category</h1>

<form asp-controller="Admin" asp-action="EditCategory" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-controller="Admin" asp-action="Categories" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
