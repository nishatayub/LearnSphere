@model IEnumerable<LearnSphere.Models.ViewModels.CategoryListItemViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<p class="text-muted mb-1"><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></p>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Manage Categories</h1>
    <a asp-controller="Admin" asp-action="CreateCategory" class="btn btn-primary">+ New Category</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Courses</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td class="text-muted small">@category.Description</td>
                <td>@category.CourseCount</td>
                <td class="text-end">
                    <a asp-controller="Admin" asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-controller="Admin" asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                        <input type="hidden" name="id" value="@category.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" @(category.CourseCount > 0 ? "disabled" : "")>Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
