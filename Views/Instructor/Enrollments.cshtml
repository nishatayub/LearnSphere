@model IEnumerable<LearnSphere.Models.Enrollment>
@using LearnSphere.Models
@{
    var course = (Course)ViewBag.Course;
    ViewData["Title"] = course.Title + " - Enrollments";
}

<p class="text-muted mb-1"><a asp-controller="Instructor" asp-action="Index">My Courses</a></p>
<h1 class="mb-4">@course.Title &middot; Enrollments</h1>

@if (!Model.Any())
{
    <p class="text-muted">No students have enrolled in this course yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Student</th>
                <th>Enrolled</th>
                <th>Status</th>
                <th>Progress</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in Model)
            {
                <tr>
                    <td>
                        @enrollment.User.FirstName @enrollment.User.LastName
                        <div class="text-muted small">@enrollment.User.Email</div>
                    </td>
                    <td>@enrollment.EnrolledDate.ToString("MMM d, yyyy")</td>
                    <td>
                        <span class="badge @(enrollment.Status == EnrollmentStatus.Completed ? "bg-success" : "bg-secondary")">
                            @enrollment.Status
                        </span>
                    </td>
                    <td style="min-width: 160px;">
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar" style="width: @(enrollment.ProgressPercentage)%"></div>
                        </div>
                        <span class="text-muted small">@enrollment.ProgressPercentage%</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
