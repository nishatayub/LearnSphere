@model IEnumerable<LearnSphere.Models.Course>

@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Courses</h1>
    <a asp-controller="Instructor" asp-action="CreateCourse" class="btn btn-primary">+ New Course</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">You haven't created any courses yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Enrollments</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>@course.Category.Name</td>
                    <td>
                        <span class="badge @(course.Status switch {
                            LearnSphere.Models.CourseStatus.Published => "bg-success",
                            LearnSphere.Models.CourseStatus.UnderReview => "bg-warning text-dark",
                            _ => "bg-secondary"
                        })">
                            @course.Status
                        </span>
                    </td>
                    <td>
                        <a asp-controller="Instructor" asp-action="Enrollments" asp-route-courseId="@course.Id">@course.TotalEnrollments</a>
                    </td>
                    <td class="text-end">
                        <a asp-controller="Instructor" asp-action="Lessons" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-secondary">Lessons</a>
                        <a asp-controller="Instructor" asp-action="Analytics" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-secondary">Analytics</a>
                        <a asp-controller="Instructor" asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        @if (course.Status == LearnSphere.Models.CourseStatus.Draft)
                        {
                            <form asp-controller="Instructor" asp-action="Publish" method="post" class="d-inline">
                                <input type="hidden" name="courseId" value="@course.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Submit for Review</button>
                            </form>
                        }
                        else if (course.Status == LearnSphere.Models.CourseStatus.UnderReview)
                        {
                            <span class="text-muted small">Awaiting admin approval</span>
                        }
                        else if (course.Status == LearnSphere.Models.CourseStatus.Published)
                        {
                            <a asp-controller="Instructor" asp-action="NewVersion" asp-route-courseId="@course.Id" class="btn btn-sm btn-outline-secondary">New Version</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
