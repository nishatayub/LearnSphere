@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Check Your Email</h1>
        <p>
            If an account exists for that email, a password reset link has been sent to it.
        </p>

        @if (ViewBag.ResetLink != null)
        {
            <div class="alert alert-warning">
                <strong>Demo mode:</strong> this project doesn't have an email service configured,
                so here's the reset link that would normally be emailed to you:
                <div class="mt-2"><a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a></div>
            </div>
        }
    </div>
</div>
