@model LearnSphere.Models.ViewModels.LessonViewModel
@using LearnSphere.Models

@{
    ViewData["Title"] = Model.Lesson.Title;
}

<p class="text-muted mb-1">
    <a asp-controller="Courses" asp-action="Learn" asp-route-id="@Model.Course.Id">@Model.Course.Title</a>
</p>
<h1 class="mb-3">@Model.Lesson.Title</h1>

<div class="mb-4">
    @switch (Model.Lesson.ContentType)
    {
        case ContentType.Text:
            if (!string.IsNullOrWhiteSpace(Model.Lesson.Content))
            {
                <div class="lesson-text">@Model.Lesson.Content</div>
            }
            else
            {
                <p class="text-muted">This lesson doesn't have any written content yet.</p>
            }
            break;

        case ContentType.Video:
            if (!string.IsNullOrWhiteSpace(Model.Lesson.ContentUrl))
            {
                <div class="ratio ratio-16x9">
                    <video controls src="@Model.Lesson.ContentUrl"></video>
                </div>
            }
            else
            {
                <p class="text-muted">Video content for this lesson hasn't been uploaded yet.</p>
            }
            break;

        case ContentType.PDF:
            if (!string.IsNullOrWhiteSpace(Model.Lesson.ContentUrl))
            {
                <a href="@Model.Lesson.ContentUrl" target="_blank" rel="noopener" class="btn btn-outline-primary">Open PDF</a>
            }
            else
            {
                <p class="text-muted">The PDF for this lesson hasn't been uploaded yet.</p>
            }
            break;

        default:
            <p class="text-muted">This content type isn't supported yet.</p>
            break;
    }
</div>

<div class="d-flex justify-content-between align-items-center border-top pt-3">
    <div>
        @if (Model.PreviousLessonId.HasValue)
        {
            <a asp-controller="Courses" asp-action="Lesson" asp-route-courseId="@Model.Course.Id" asp-route-lessonId="@Model.PreviousLessonId" class="btn btn-outline-secondary">&larr; Previous</a>
        }
    </div>

    <form asp-controller="Courses" asp-action="ToggleLesson" method="post">
        <input type="hidden" name="courseId" value="@Model.Course.Id" />
        <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
        <input type="hidden" name="returnUrl" value="@Url.Action("Lesson", "Courses", new { courseId = Model.Course.Id, lessonId = Model.Lesson.Id })" />
        <button type="submit" class="btn @(Model.IsCompleted ? "btn-success" : "btn-primary")">
            @(Model.IsCompleted ? "Completed" : "Mark complete")
        </button>
    </form>

    <div>
        @if (Model.NextLessonId.HasValue)
        {
            <a asp-controller="Courses" asp-action="Lesson" asp-route-courseId="@Model.Course.Id" asp-route-lessonId="@Model.NextLessonId" class="btn btn-outline-secondary">Next &rarr;</a>
        }
    </div>
</div>
