@model LearnSphere.Models.ViewModels.CourseListViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using LearnSphere.Models
@using LearnSphere.Models.ViewModels

@{
    ViewData["Title"] = "Courses";
}

<h1 class="mb-4">Courses</h1>

<form asp-controller="Courses" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-sm-4">
        <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search courses..." />
    </div>
    <div class="col-sm-2">
        <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-sm-2">
        <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<DifficultyLevel>()">
            <option value="">Any difficulty</option>
        </select>
    </div>
    <div class="col-sm-2">
        <select asp-for="Sort" class="form-select" asp-items="Html.GetEnumSelectList<CourseSortOrder>()"></select>
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (!Model.Courses.Any())
{
    <p class="text-muted">No courses match your search.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@course.Difficulty</span>
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text small">@course.Description</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="text-muted small">@course.EstimatedDurationHours hrs</span>
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">View Course</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Courses" asp-action="Index"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-difficulty="@Model.Difficulty"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
